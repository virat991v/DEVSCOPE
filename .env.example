# DevScope — environment variable reference
# Copy to .env.local for local development.
# Never commit real credentials to the repository.
# NEVER use VITE_ prefix for secrets — those values are bundled into the browser.

# ─── Supabase (Phase 2+) ───────────────────────────────────────────────────
# Browser-safe: anon key has RLS enforcement; safe to expose in frontend bundle
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (Edge Functions / worker — never VITE_ prefixed)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── GitHub App (Phase 3+) ─────────────────────────────────────────────────
# All GitHub secrets are server-side only — never expose in browser
# GITHUB_APP_ID=123456
# GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# GITHUB_APP_CLIENT_SECRET=your-client-secret        ← server-side only
# GITHUB_WEBHOOK_SECRET=your-webhook-secret           ← server-side only
# GITHUB_OAUTH_CALLBACK_URL=https://your-app.pages.dev/github-callback
# ALLOWED_ORIGIN=https://your-app.pages.dev

# Browser-safe: only the GitHub App install URL (no secret, just a link)
VITE_GITHUB_APP_URL=https://github.com/apps/your-app-slug

# ─── Application settings ─────────────────────────────────────────────────
# VITE_DEMO_MODE=true       # Set to false to disable demo switcher in production
# VITE_APP_ENV=development  # development | production

# ─── Optional ─────────────────────────────────────────────────────────────
# VITE_INSTITUTION_SLUG=apex   # Pre-select institution on load
